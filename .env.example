# PostgreSQL (Neon/Supabase) — pooled bağlantı (uygulama runtime'ı için)
DATABASE_URL=

# PostgreSQL — pooling olmayan doğrudan bağlantı (Prisma migration'ları için)
DIRECT_URL=

# NextAuth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Vercel Cron ile tetiklenen /api/cron/* endpoint'lerini korumak için paylaşılan sır
CRON_SECRET=

# Upstash Redis (REST) — login/register rate limiting için (src/lib/server/rate-limit.ts).
# Opsiyonel: boş bırakılırsa modül otomatik olarak in-memory fallback'e düşer.
# ⚠️ In-memory fallback SADECE yerel geliştirme içindir — Vercel'in stateless
# serverless instance'larında gerçek bir limit UYGULAMAZ (her instance kendi
# sayacını tutar). Production'da MUTLAKA doldurun (Upstash ücretsiz katmanı
# yeterli: console.upstash.com → Redis → REST API bilgileri, veya Vercel
# Marketplace > Upstash entegrasyonu bu iki değeri otomatik ekler).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (https://resend.com) — şifre sıfırlama ve e-posta doğrulama
# bağlantılarını gerçekten göndermek için (src/lib/server/email/send.ts).
# Opsiyonel: boş bırakılırsa gönderilecek e-posta gerçekten yollanmaz,
# içeriği (bağlantı dahil) sunucu konsoluna loglanır — SADECE yerel
# geliştirme için kabul edilebilir, production'da MUTLAKA doldurun
# (Resend ücretsiz katmanı yeterli: resend.com → API Keys).
RESEND_API_KEY=
# Gönderen adresi — Resend hesabınızda doğrulanmış bir alan adı gerekir.
# Boş bırakılırsa Resend'in sandbox göndereni kullanılır
# (onboarding@resend.dev — sadece test için, gerçek alıcılara güvenilir
# teslimat garantisi yoktur).
FROM_EMAIL=
